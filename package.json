{
  "name": "@gaatshort/web",
  "version": "0.1.0",
  "description": "Gaatshort — site utilisateur des marques (Next.js, rendu serveur, PWA), adossé à l'API gaatshort-backend",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <25"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/unit.xml"
  },
  "pnpm": {
    "//": "pnpm 10 n'exécute plus les scripts d'installation par défaut. esbuild (Vitest), sharp (images Next) et unrs-resolver (ESLint) en ont besoin pour poser leur binaire natif. Liste volontairement close : on autorise ce qu'on a examiné, pas tout ce qui le demande.",
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "source-map-js@<1.2.2": "^1.2.2"
    }
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
