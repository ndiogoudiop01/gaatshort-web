# ──────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────
# `development` | `staging` | `production`. Hors production, robots.txt interdit l'indexation.
APP_ENV=development
SITE_URL=http://localhost:3001

# ──────────────────────────────────────────────────────
# API (gaatshort-backend)
# ──────────────────────────────────────────────────────
# Préfixe ET version inclus. Toutes les requêtes partent du SERVEUR Next : cette URL n'est jamais
# exposée au navigateur. En production, joindre l'API directement (réseau interne CapRover).
API_BASE_URL=http://localhost:3000/api/v1
API_TIMEOUT_MS=8000
# Doit valoir TENANCY_HEADER_NAME du backend.
TENANCY_HEADER_NAME=x-tenant-id

# ──────────────────────────────────────────────────────
# MARQUE
# ──────────────────────────────────────────────────────
# La marque est résolue par l'HÔTE de la requête (domaine ou sous-domaine déclaré dans
# tenant_domains). DEV_TENANT ne sert que lorsque l'hôte ne désigne aucune marque (localhost) :
# slug d'une marque du seed. Interdit en production (le démarrage échoue).
DEV_TENANT=gaatshort
